# Drupal project gitignore
#
# Composer-managed dependencies and build artifacts
vendor/
drush/contrib
web/core
web/modules/contrib
web/libraries
web/themes/contrib
node_modules/
.sass-cache
.eyeglass_cache
*.css.map

# User-generated content (not in git)
web/sites/*/files/*
web/sites/*/private/*

# Local settings (never commit secrets)
web/sites/*/settings.local.php
web/sites/*/settings.php
web/sites/settings*.php
web/sites/*/services*.yml

# DDEV local config (optional – commit if you share DDEV config)
# .ddev/

# Generated scaffold files (Composer scaffold overrides these)
/.editorconfig
web/.csslintrc
web/.eslintignore
web/.eslintrc.json
web/.ht.router.php
web/.htaccess
web/example.gitignore
web/index.php
web/INSTALL.txt
web/README.txt
web/robots.txt
web/update.php
web/web.config
web/sites/README.txt
web/sites/development.services.yml
web/sites/example.settings.local.php
web/sites/example.sites.php
web/sites/default/default.services.yml
web/sites/default/default.settings.php
web/modules/README.txt
web/profiles/README.txt
web/themes/README.txt

# Drupal scaffold recipes
recipes/

# Exported Drupal config sync (per-environment, may contain different hashes)
# web/sites/default/files/sync/

# OS and editor files
.DS_Store
.DS_Store?
.idea
*.swp
*.swo
*~
npm-debug.log
yarn-error.log

# Environment variables (may contain secrets)
.env
.env.local
.env.*.local
