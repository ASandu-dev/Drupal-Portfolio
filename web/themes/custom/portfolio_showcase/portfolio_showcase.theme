<?php

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\node\Entity\Node;

/**
 * Implements hook_preprocess_page().
 */
function portfolio_showcase_preprocess_page(array &$variables): void {
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }

  // Load calendar block.
  if (!\Drupal::moduleHandler()->moduleExists('portfolio_calendar')) {
    $variables['portfolio_calendar_block'] = [];
  }
  else {
    $block_manager = \Drupal::service('plugin.manager.block');
    $plugin_block = $block_manager->createInstance('portfolio_calendar_pulse_block', []);
    $access = $plugin_block->access(\Drupal::currentUser(), TRUE);

    if (!$access->isAllowed()) {
      $variables['portfolio_calendar_block'] = [];
    }
    else {
      $build = $plugin_block->build();
      CacheableMetadata::createFromObject($access)->applyTo($build);
      $variables['portfolio_calendar_block'] = $build;
    }
  }

  // Load project nodes for the front page.
  $nids = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'project')
    ->condition('status', 1)
    ->sort('created', 'DESC')
    ->range(0, 50)
    ->execute();

  $variables['projects'] = [];
  if (!empty($nids)) {
    $nodes = Node::loadMultiple($nids);
    $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    foreach ($nodes as $node) {
      $view = $view_builder->view($node, 'teaser');
      $variables['projects'][] = $view;
    }
  }

  // Ensure the page cache is invalidated when any project node is modified.
  (new CacheableMetadata())
    ->addCacheTags(['node_list:project'])
    ->applyTo($variables);
}
