<?php

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Datetime\DateFormatterInterface;
use Drupal\Core\Url;
use Drupal\node\Entity\Node;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_preprocess_page().
 */
function portfolio_showcase_preprocess_page(array &$variables): void {
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }

  // Load calendar block.
  if (!\Drupal::moduleHandler()->moduleExists('portfolio_calendar')) {
    $variables['portfolio_calendar_block'] = [];
  }
  else {
    $block_manager = \Drupal::service('plugin.manager.block');
    $plugin_block = $block_manager->createInstance('portfolio_calendar_pulse_block', []);
    $access = $plugin_block->access(\Drupal::currentUser(), TRUE);

    if (!$access->isAllowed()) {
      $variables['portfolio_calendar_block'] = [];
    }
    else {
      $build = $plugin_block->build();
      CacheableMetadata::createFromObject($access)->applyTo($build);
      $variables['portfolio_calendar_block'] = $build;
    }
  }

  // Load project nodes for the front page.
  $nids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'project')
    ->condition('status', 1)
    ->sort('created', 'DESC')
    ->range(0, 50)
    ->execute();

  $variables['projects'] = [];
  if (!empty($nids)) {
    $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
    foreach (Node::loadMultiple($nids) as $nid => $node) {
      $variables['projects'][$nid] = $view_builder->view($node, 'teaser');
    }
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * Provides computed variables for blog_post nodes to keep Twig templates
 * clean and avoid inline logic.
 */
function portfolio_showcase_preprocess_node(array &$variables): void {
  $node = $variables['node'];

  if ($node->getType() !== 'blog_post') {
    return;
  }

  $date_formatter = \Drupal::service('date.formatter');
  assert($date_formatter instanceof DateFormatterInterface);

  // -- Date --
  $pub_date_raw = $node->get('field_published_date')->value;
  $timestamp = !empty($pub_date_raw)
    ? $node->get('field_published_date')->date->getTimestamp()
    : $node->getCreatedTime();

  $variables['date'] = [
    'iso' => date('c', (int) $timestamp),
    'formatted' => $date_formatter->format((int) $timestamp, 'blog_date'),
  ];

  // -- Reading time --
  $minutes = $node->get('field_reading_time')->value;
  $variables['reading_time'] = !empty($minutes)
    ? \Drupal::translation()->formatPlural((int) $minutes, '1 min read', '@count min read')
    : '';

  // -- Author info (derived from node owner) --
  $owner = $node->getOwner();
  $variables['author'] = [
    'name' => $owner instanceof UserInterface ? $owner->getDisplayName() : t('Anonymous'),
    'initials' => _portfolio_showcase_get_initials($owner instanceof UserInterface ? $owner->getDisplayName() : ''),
    'bio' => '',
  ];

  // Attempt to get a bio from a user field if it exists.
  if ($owner instanceof UserInterface && $owner->hasField('field_bio')) {
    $bio = $owner->get('field_bio')->value;
    if (!empty($bio)) {
      $variables['author']['bio'] = $bio;
    }
  }

  // -- Category label (taxonomy-configurable via a site setting or just "Report") --
  $variables['category_label'] = t('Report');

  // If the node uses a specific taxonomy term as primary category, use it.
  $tags = $node->get('field_tags')->referencedEntities();
  if (!empty($tags)) {
    $first_tag = reset($tags);
    if ($first_tag instanceof \Drupal\taxonomy\TermInterface) {
      $variables['category_label'] = $first_tag->label();
    }
  }

  // -- Back URL --
  $variables['back_url'] = Url::fromUserInput('/blog')->toString();

  // -- Excerpt (lead) and CTA from the app-generated fields --
  // The ScanSentinel app publishes field_excerpt (Summary/Excerpt) and a
  // suggested CTA. Surface them so the full view matches the app preview.
  $excerpt = $node->get('field_excerpt')->value;
  $variables['excerpt'] = !empty($excerpt) ? trim($excerpt) : '';

  // Suggested CTA is stored on field_external_url only when it is a real URL.
  // If it is just text (a call-to-action sentence), show it as a CTA block.
  $variables['cta'] = '';
  if ($node->hasField('field_external_url') && !$node->get('field_external_url')->isEmpty()) {
    $uri = $node->get('field_external_url')->uri;
    if (!empty($uri) && !preg_match('#^https?://#i', $uri)) {
      $variables['cta'] = $node->get('field_external_url')->value;
    }
  }
}

/**
 * Extracts initials from a display name.
 *
 * "Andrei Sandu" -> "AS"
 * "Andrei"        -> "A"
 */
function _portfolio_showcase_get_initials(string $name): string {
  $parts = preg_split('/\s+/', trim($name));
  if (empty($parts) || $parts === FALSE) {
    return '?';
  }
  $initials = '';
  foreach ($parts as $part) {
    if (mb_strlen($part) > 0) {
      $initials .= mb_strtoupper(mb_substr($part, 0, 1));
    }
  }
  return $initials !== '' ? $initials : '?';
}