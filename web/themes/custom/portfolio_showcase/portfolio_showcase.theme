<?php

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;

/**
 * Implements hook_preprocess_page().
 */
function portfolio_showcase_preprocess_page(array &$variables): void {
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }

  if (!\Drupal::moduleHandler()->moduleExists('portfolio_calendar')) {
    $variables['portfolio_calendar_block'] = [];
    return;
  }

  $block_manager = \Drupal::service('plugin.manager.block');
  $plugin_block = $block_manager->createInstance('portfolio_calendar_pulse_block', []);
  $access = $plugin_block->access(\Drupal::currentUser(), TRUE);

  if (!$access->isAllowed()) {
    $variables['portfolio_calendar_block'] = [];
    return;
  }

  $build = $plugin_block->build();
  CacheableMetadata::createFromObject($access)->applyTo($build);
  $variables['portfolio_calendar_block'] = $build;
}
