{#
/**
 * @file
 * Template for the blog listing page.
 * View machine name: blog
 *
 * Design: Clean listing with premium grid, staggered fade-in
 * animation on cards, and responsive pagination.
 */
#}
{%
  set classes = [
    'py-12 md:py-20 lg:py-24',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {# Page header #}
    <div class="mb-12 md:mb-16 text-center max-w-3xl mx-auto">
      <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 dark:text-emerald-400 text-xs font-bold uppercase tracking-widest mb-4">
        {{ 'Blog'|t }}
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4 tracking-tight">
        {{ 'Intelligence Reports'|t }}
      </h1>
      <p class="text-base sm:text-lg text-gray-500 dark:text-gray-400 leading-relaxed">
        {{ 'Technical deep-dives into cybersecurity, web vulnerabilities, and secure coding practices.'|t }}
      </p>
    </div>

    {# Grid #}
    {% if rows %}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {{ rows }}
      </div>
    {% else %}
      <div class="text-center py-20">
        <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{{ 'No reports yet'|t }}</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">{{ 'Check back soon for new intelligence reports.'|t }}</p>
      </div>
    {% endif %}

    {# Pagination #}
    {% if pager %}
      <nav class="mt-16" aria-label="{{ 'Pagination'|t }}">
        {{ pager }}
      </nav>
    {% endif %}
  </div>
</div>
