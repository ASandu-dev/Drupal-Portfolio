{% set image = node.field_featured_image.entity %}
{% set image_url = image ? file_url(image.uri.value) : '' %}
{% set pub_date = node.field_published_date[0].value ?? '' %}
{% set reading_time = node.field_reading_time[0].value ?? 0 %}

<article{{ attributes.addClass('reading-container') }}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    {# Reading progress bar #}
    <div class="fixed top-0 left-0 h-1 bg-emerald-500 z-50 transition-all duration-150"
         id="reading-progress" style="width: 0%"></div>

    {# Header #}
    <header class="mb-12">
      <div class="flex items-center gap-3 text-xs font-bold text-emerald-500 uppercase tracking-widest mb-6">
        <span>{{ 'Intelligence Report'|t }}</span>
        <span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span>
        <time datetime="{{ pub_date }}">{{ pub_date ? pub_date|date('F j, Y') : node.getCreatedTime()|date('F j, Y') }}</time>
        {% if reading_time %}
          <span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span>
          <span>{{ reading_time }} min read</span>
        {% endif %}
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-6 leading-tight tracking-tight">
        {{ label }}
      </h1>

      {% if content.field_excerpt|render %}
        <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 leading-relaxed mb-8">
          {{ content.field_excerpt }}
        </p>
      {% endif %}

      {# Author card #}
      <div class="flex items-center gap-4 py-6 border-y border-gray-100 dark:border-gray-800">
        <div class="w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-500 font-bold text-sm">AS</div>
        <div>
          <div class="text-sm font-bold text-gray-900 dark:text-white">{{ node.getOwner().displayName }}</div>
          <div class="text-xs text-gray-500">Drupal Architect &amp; Security Researcher</div>
        </div>
      </div>
    </header>

    {# Featured image #}
    {% if image_url %}
      <figure class="mb-12 -mx-4 sm:mx-0">
        <img src="{{ image_url }}" alt="{{ node.field_featured_image.alt }}" class="w-full h-auto rounded-2xl object-cover" loading="lazy">
        {% if node.field_featured_image.alt %}
          <figcaption class="mt-3 text-center text-xs text-gray-400">{{ node.field_featured_image.alt }}</figcaption>
        {% endif %}
      </figure>
    {% endif %}

    {# Table of contents (auto-generated from body headings) #}
    <div class="mb-12 p-6 glass rounded-2xl hidden md:block" id="toc">
      <h2 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider mb-4">{{ 'In this article'|t }}</h2>
      <nav class="toc-links text-sm space-y-2" id="toc-links">
      </nav>
    </div>

    {# External link #}
    {% if node.field_external_url[0] %}
      <div class="mb-8 p-4 bg-emerald-500/5 border border-emerald-500/20 rounded-xl">
        <a href="{{ node.field_external_url[0].uri }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-500 hover:underline">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          {{ 'Read original article'|t }} &rarr;
        </a>
      </div>
    {% endif %}

    {# Body content #}
    <div{{ content_attributes.addClass('prose prose-lg md:prose-xl dark:prose-invert max-w-none') }}>
      {{ content.body }}
    </div>

    {# Tags #}
    {% if content.field_tags|render %}
      <div class="mt-16 pt-8 border-t border-gray-100 dark:border-gray-800">
        <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-4">{{ 'Topics'|t }}</h3>
        <div class="flex flex-wrap gap-2">
          {{ content.field_tags }}
        </div>
      </div>
    {% endif %}

    {# Footer / back link #}
    <footer class="mt-16 pt-8 border-t border-gray-100 dark:border-gray-800">
      <div class="flex flex-col md:flex-row justify-between items-center gap-6">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-500 hover:gap-3 transition-all group">
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          {{ 'Back to Intelligence Reports'|t }}
        </a>

        <div class="flex items-center gap-4">
          <button onclick="window.scrollTo({top:0,behavior:'smooth'})" class="text-sm text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
            {{ 'Back to top'|t }} &uarr;
          </button>
        </div>
      </div>
    </footer>
  </div>
</article>

{# Reading progress & ToC JavaScript #}
<script>
(function() {
  // Reading progress bar
  var bar = document.getElementById('reading-progress');
  if (bar) {
    window.addEventListener('scroll', function() {
      var scroll = window.scrollY || document.documentElement.scrollTop;
      var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      bar.style.width = height > 0 ? ((scroll / height) * 100) + '%' : '0%';
    });
  }

  // Auto-generate table of contents from body headings
  var toc = document.getElementById('toc-links');
  if (toc) {
    var content = document.querySelector('.prose');
    if (content) {
      var headings = content.querySelectorAll('h2, h3');
      if (headings.length >= 2) {
        headings.forEach(function(h, i) {
          var id = 'section-' + i;
          h.id = id;
          var li = document.createElement('a');
          li.href = '#' + id;
          li.className = 'block text-gray-600 dark:text-gray-400 hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors py-0.5';
          if (h.tagName === 'H3') li.className += ' pl-4';
          li.textContent = h.textContent;
          toc.appendChild(li);
        });
      } else {
        document.getElementById('toc').style.display = 'none';
      }
    }
  }
})();
</script>
