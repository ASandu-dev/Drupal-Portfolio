{#
/**
 * @file
 * Theme override for the full blog_post node display.
 *
 * Aligned with the ScanSentinel Marketing Command Center output:
 *   - Hero image (field_featured_image)
 *   - Category badge + date
 *   - Title
 *   - Excerpt rendered as a lead paragraph (field_excerpt)
 *   - Body HTML (generated by the app)
 *   - Tags (field_tags)
 *   - Optional suggested CTA (field_external_url when it is plain text)
 *
 * All variables fall back gracefully when a field is empty so the layout
 * never breaks, matching the app's always-complete preview.
 */
#}

<article{{ attributes.addClass('blog-full') }}>

  {# --- Header --- #}
  <header class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 md:pt-24 pb-8 md:pb-12">

    {# Category badge + date #}
    <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-widest mb-6">
      {% if category_label %}
        <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 dark:text-emerald-400">
          {{ category_label }}
        </span>
      {% endif %}
      <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600" aria-hidden="true"></span>
      <time datetime="{{ date.iso }}" class="text-gray-400 dark:text-gray-500">{{ date.formatted }}</time>
    </div>

    {# Title #}
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 dark:text-white leading-tight tracking-tight mb-8">
      {{ label }}
    </h1>

    {# Author block (only when an author is resolved) #}
    {% if author.name %}
      <div class="flex items-center justify-between py-5 border-y border-gray-100 dark:border-gray-800">
        <div class="flex items-center gap-4">
          <div class="w-11 h-11 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-500 font-bold text-sm flex-shrink-0">
            {{ author.initials }}
          </div>
          <div>
            <div class="text-sm font-semibold text-gray-900 dark:text-white">{{ author.name }}</div>
            {% if author.bio %}
              <div class="text-xs text-gray-500 dark:text-gray-400">{{ author.bio }}</div>
            {% endif %}
          </div>
        </div>
        {% if reading_time %}
          <div class="text-xs font-medium text-gray-400 dark:text-gray-500 flex-shrink-0">{{ reading_time }}</div>
        {% endif %}
      </div>
    {% endif %}
  </header>

  {# --- Featured Image (hero) --- #}
  {% if content.field_featured_image|render|striptags|trim is not empty %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
      <figure class="rounded-2xl overflow-hidden shadow-lg">
        {{ content.field_featured_image }}
      </figure>
    </div>
  {% endif %}

  {# --- Excerpt as lead paragraph (matches app preview) --- #}
  {% if excerpt %}
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
      <p class="text-lg sm:text-xl text-gray-500 dark:text-gray-400 leading-relaxed font-medium">
        {{ excerpt }}
      </p>
    </div>
  {% endif %}

  {# --- External link (real URL only) --- #}
  {% set has_external_url = node.field_external_url is not empty and node.field_external_url.0.uri is not empty and node.field_external_url.0.uri starts with 'http' %}
  {% if has_external_url %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
      <div class="group relative rounded-2xl border border-emerald-500/20 bg-emerald-500/5 dark:bg-emerald-500/10 p-5 sm:p-6 transition-all duration-300 hover:border-emerald-500/40 hover:bg-emerald-500/10 dark:hover:bg-emerald-500/15 hover:shadow-lg hover:shadow-emerald-500/10">
        <div class="flex items-center gap-4">
          <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-500 transition-transform duration-300 group-hover:scale-110">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-500/70 dark:text-emerald-400/70 mb-1">{{ 'External Resource'|t }}</p>
            <div class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 truncate [&_a]:text-emerald-600 dark:[&_a]:text-emerald-400 [&_a]:no-underline group-hover:[&_a]:underline">
              {{ content.field_external_url }}
            </div>
          </div>
          <div class="flex-shrink-0 text-emerald-500/50 transition-transform duration-300 group-hover:translate-x-1">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {# --- Body Content (HTML generated by the app) --- #}
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div{{ content_attributes.addClass('prose prose-lg dark:prose-invert max-w-none blog-prose') }}>
      {{ content.body }}
    </div>
  </div>

  {# --- Suggested CTA (plain-text call to action) --- #}
  {% if cta %}
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 dark:bg-emerald-500/10 p-5 sm:p-6 text-center">
        <p class="text-sm font-semibold text-emerald-600 dark:text-emerald-400">{{ cta }}</p>
      </div>
    </div>
  {% endif %}

  {# --- Tags --- #}
  {% set has_tags = content.field_tags|render|striptags|trim is not empty %}
  {% if has_tags %}
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="pt-8 border-t border-gray-100 dark:border-gray-800">
        <div class="flex flex-wrap gap-2">
          {{ content.field_tags }}
        </div>
      </div>
    </div>
  {% endif %}

  {# --- Footer --- #}
  <footer class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="pt-8 border-t border-gray-100 dark:border-gray-800">
      <a href="{{ back_url }}" class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-500 dark:text-emerald-400 hover:gap-3 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-emerald-500 focus-visible:outline-offset-4 rounded">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        {{ 'Back to Intelligence Reports'|t }}
      </a>
    </div>
  </footer>

</article>
