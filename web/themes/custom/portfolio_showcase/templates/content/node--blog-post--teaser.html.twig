{#
/**
 * @file
 * Theme override for blog post teaser cards.
 *
 * Design system: Premium SaaS card with 8pt spacing grid,
 * subtle micro-interactions, and conversion-focused CTAs.
 *
 * Available variables:
 * - label: Node title (linked to node in Drupal, but we build our own link)
 * - url: Canonical node URL
 * - node: Full node entity
 * - content: Render arrays keyed by field name
 * - attributes: HTML attributes for the wrapping element
 * - view_mode: 'teaser'
 * - date: Computed via preprocess
 * - reading_time: Computed via preprocess (string, empty if none)
 */
#}
{% set has_tags = content.field_tags|render|striptags|trim is not empty %}
{% set has_excerpt = content.field_excerpt|render|striptags|trim is not empty %}
{% set has_image = node.field_featured_image is not empty and node.field_featured_image.entity is not empty %}

<article{{ attributes.addClass('blog-teaser group relative flex flex-col h-full bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-800 overflow-hidden transition-all duration-300 hover:shadow-xl hover:shadow-gray-200/50 dark:hover:shadow-gray-950/50 hover:border-gray-200 dark:hover:border-gray-700 hover:-translate-y-1') }}>

  {# --- Media Section --- #}
  <a href="{{ url }}" class="block relative overflow-hidden aspect-[16/10] bg-gray-100 dark:bg-gray-800 [&_img]:w-full [&_img]:h-full [&_img]:object-cover" aria-hidden="true" tabindex="-1">
    {% if has_image %}
      {{ content.field_featured_image }}
    {% else %}
      <div class="flex items-center justify-center h-full">
        <svg class="w-16 h-16 text-gray-200 dark:text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
        </svg>
      </div>
    {% endif %}

    {# Hover gradient overlay #}
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-400 pointer-events-none"></div>
  </a>

  {# --- Tags overlay (pinned to image bottom-left) --- #}
  {% if has_tags %}
    <div class="absolute top-[calc(62.5%-2rem)] left-3 flex flex-wrap gap-1.5 z-10">
      {{ content.field_tags }}
    </div>
  {% endif %}

  {# --- Card Body --- #}
  <div class="flex flex-col flex-1 p-5 sm:p-6">

    {# Meta row: date + reading time #}
    <div class="flex items-center gap-2 text-xs font-medium text-gray-400 dark:text-gray-500 mb-3">
      <time datetime="{{ date.iso }}">{{ date.formatted }}</time>
      {% if reading_time %}
        <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600" aria-hidden="true"></span>
        <span>{{ reading_time }}</span>
      {% endif %}
    </div>

    {# Title #}
    <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white mb-2 leading-snug tracking-tight group-hover:text-emerald-500 dark:group-hover:text-emerald-400 transition-colors duration-200">
      <a href="{{ url }}" rel="bookmark" class="focus:outline-none focus-visible:underline focus-visible:decoration-emerald-500 focus-visible:decoration-2 focus-visible:underline-offset-4">
        <span class="absolute inset-0 z-10" aria-hidden="true"></span>
        {{ label }}
      </a>
    </h3>

    {# Excerpt #}
    {% if has_excerpt %}
      <div class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed line-clamp-3 mb-4">
        {{ content.field_excerpt }}
      </div>
    {% endif %}

    {# CTA link #}
    <div class="mt-auto pt-2">
      <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-500 dark:text-emerald-400 group-hover:gap-2.5 transition-all duration-200">
        {{ 'Read Report'|t }}
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </span>
    </div>
  </div>
</article>
